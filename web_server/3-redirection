#!/usr/bin/env bash
# Installs Nginx and configures a 301 redirect for /redirect_me
apt-get update -y
apt-get install -y nginx
echo "Holberton School for the win!" > /var/www/html/index.html
CONF="/etc/nginx/sites-available/default"
grep -q "redirect_me" "$CONF" || sed -i 's/server_name _;/server_name _;\n\n\tlocation \/redirect_me {\n\t\treturn 301 https:\/\/www.youtube.com\/watch?v=QH2-TGUlwu4;\n\t}/' "$CONF"
service nginx restart
