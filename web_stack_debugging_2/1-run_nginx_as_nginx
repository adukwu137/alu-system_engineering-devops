#!/usr/bin/env bash
# Stops Apache and runs Nginx master and worker processes as the nginx user on port 8080
id -u nginx >/dev/null 2>&1 || useradd -r -s /usr/sbin/nologin nginx
pkill -9 -x apache2 >/dev/null 2>&1 || true
pkill -9 -x nginx >/dev/null 2>&1 || true
mkdir -p /var/log/nginx /var/lib/nginx /var/cache/nginx
chown -R nginx:nginx /var/log/nginx /var/lib/nginx /var/cache/nginx
chmod -R a+rX /etc/nginx
sed -i 's/^#*user .*/user nginx;/g' /etc/nginx/nginx.conf
sed -i 's|pid /run/nginx.pid;|pid /tmp/nginx.pid;|g' /etc/nginx/nginx.conf
sed -i 's/listen 80 /listen 8080 /g; s/\[::\]:80 /[::]:8080 /g' /etc/nginx/sites-available/default
su -s /bin/bash nginx -c "/usr/sbin/nginx"
