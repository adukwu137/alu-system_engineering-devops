#!/usr/bin/env bash
# Configures Nginx to run as the nginx user and listen on port 8080
id -u nginx >/dev/null 2>&1 || useradd -r -s /usr/sbin/nologin nginx
mkdir -p /var/log/nginx /var/lib/nginx/body /run
chown -R nginx:nginx /var/log/nginx /var/lib/nginx /run
sed -i 's/user www-data;/user nginx;/g; s/user root;/user nginx;/g' /etc/nginx/nginx.conf
for f in /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default /etc/nginx/nginx.conf /etc/nginx/conf.d/*.conf; do
  [ -f "$f" ] && sed -i 's/listen 80;/listen 8080;/g; s/listen 80 /listen 8080 /g; s/\[::\]:80;/[::]:8080;/g; s/\[::\]:80 /[::]:8080 /g' "$f"
done
service nginx stop >/dev/null 2>&1 || true
pkill -9 nginx >/dev/null 2>&1 || true
service nginx start
