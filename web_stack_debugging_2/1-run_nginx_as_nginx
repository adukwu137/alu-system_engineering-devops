#!/usr/bin/env bash
# Configures Nginx to run as the nginx user and listen on port 8080
id -u nginx >/dev/null 2>&1 || useradd -r -s /usr/sbin/nologin nginx
sed -i 's/user www-data;/user nginx;/g; s/user root;/user nginx;/g' /etc/nginx/nginx.conf
sed -i 's/listen 80 /listen 8080 /g; s/listen 80;/listen 8080;/g; s/\[::\]:80 /\[::\]:8080 /g; s/\[::\]:80;/\[::\]:8080;/g' /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default 2>/dev/null || true
service nginx stop >/dev/null 2>&1 || true
service nginx start
